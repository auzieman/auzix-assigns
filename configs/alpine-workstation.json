{
  "version": 1,
  "assigns": {
    "C": {
      "sources": ["~/.local/bin", "/usr/local/bin", "/usr/bin", "/bin"]
    },
    "Programs": {
      "sources": [
        "~/.local/share/applications",
        "~/.local/share/flatpak/exports/share/applications",
        "/var/lib/flatpak/exports/share/applications",
        "/usr/share/applications"
      ]
    },
    "Libraries": {
      "sources": ["~/.local/lib", "/usr/local/lib", "/usr/lib"]
    },
    "Sys_Libraries": {
      "sources": ["/lib"]
    }
  }
}
